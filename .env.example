# ===== AKUN TELEGRAM (WAJIB) =====
# Ambil API_ID & API_HASH di https://my.telegram.org
API_ID=123456
API_HASH=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# STRING_SESSION opsional. Kosongkan = pakai file session lokal (userbot.session).
# Isi hanya jika mau pindah-pindah device / cloud. Generate pakai string session builder.
#STRING_SESSION=

# BOT_TOKEN opsional (dari @BotFather). Aktifkan untuk menu tombol inline & tombol stop.
# Buat bot via @BotFather -> /newbot -> enable inline mode -> copy token.
#BOT_TOKEN=

# OWNER_ID opsional. Kosongkan = otomatis ambil dari akun yang login.
#OWNER_ID=123456789

# ===== LOGGING =====
# LOG_CHAT_ID opsional. Kosongkan = log dikirim ke Saved Messages.
#LOG_CHAT_ID=-1001234567890

# ===== AI GEMINI (OPSIONAL) =====
# Ambil API key di https://aistudio.google.com/apikey -> lalu aktikan "Generative Language API"
#GEMINI_KEY=AIza...
#GEMINI_MODEL=gemini-2.0-flash

# ===== ANTI-BAN / RATE LIMIT =====
# Kecepatan kirim pesan per menit (se-akun)
SEND_RATE=30
SEND_WINDOW=60
# Jeda minimal kirim ke grup yang sama (detik)
GROUP_SEND_INTERVAL=3
# Jeda acak tambahan antar aksi (detik)
GLOBAL_GAP=0.5
JITTER_MAX=1.5
# Limit join grup (per window detik)
JOIN_LIMIT=10
JOIN_WINDOW=600
JOIN_DELAY_MIN=35
JOIN_DELAY_MAX=60

# ===== PROMO =====
# Template broadcast dipisah tanda | (akan dipilih acak). Kosongkan = pakai pesan yang di-reply.
#VARIANTS=Promo 1 bro|Promo 2 bro|Promo 3 bro

# ===== LAIN-LAIN =====
# PREFIX default untuk command userbot
PREFIX=.
# Watermark/tanda di akhir setiap pesan otomatis
#WATERMARK_TEXT=by @ozysparda